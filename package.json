{
  "name": "dog-walking-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Implementation of the clients and walks services of the dog-walking specs on Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.steps.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply dog-walking --local",
    "db:migrate:remote": "wrangler d1 migrations apply dog-walking --remote",
    "test": "node scripts/with-worker.mjs -- npx cucumber-js",
    "test:unit": "vitest run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.1"
  }
}
