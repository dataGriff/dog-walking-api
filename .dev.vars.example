# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# Clerk (AUTH_MODE=clerk): the secret key of your Clerk instance.
CLERK_SECRET_KEY=sk_test_...
# Origins whose Clerk session tokens are accepted (the web app), comma-separated.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Local development without Clerk: `task dev` passes AUTH_MODE=test instead,
# and requests then authenticate as `Authorization: Bearer test:<walker_id>`.
